{
  "name": "my-vue-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:server": "vite --host 0.0.0.0 --port 5173",
    "dev:android": "sh -c 'pnpm dev:server >/tmp/triada-vite.log 2>&1 & VITE_PID=$!; trap \"kill $VITE_PID\" EXIT INT TERM; until nc -z 127.0.0.1 5173; do sleep 1; done; npx cap run android -l --host 10.0.2.2 --port 5173 --no-sync'",
    "dev:ios": "sh -c 'pnpm dev:server >/tmp/triada-vite.log 2>&1 & VITE_PID=$!; trap \"kill $VITE_PID\" EXIT INT TERM; until nc -z 127.0.0.1 5173; do sleep 1; done; npx cap run ios -l --host localhost --port 5173 --no-sync'",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios && cd ios/App && pod install && cd -",
    "cap:sync:android": "npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:copy": "npx cap copy",
    "cap:build:ios": "xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 17 Pro' build",
    "cap:build:android": "./android/gradlew -p android assembleDebug",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --cache",
    "lint:check": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --cache",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check src/",
    "build:check": "pnpm format && pnpm test:unit:coverage && pnpm type-check && pnpm lint:check && pnpm build"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "7.4.4",
    "@capacitor/status-bar": "7.0.3",
    "@primeuix/themes": "^1.1.0",
    "@vueuse/core": "^14.2.1",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "vue": "^3.5.29",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-conventional": "20.4.2",
    "@eslint/js": "9.34.0",
    "@rushstack/eslint-patch": "1.16.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "9.34.0",
    "eslint-config-love": "122.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-vue": "10.8.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "4.0.18",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "^3.2.5"
  },
  "volta": {
    "node": "v22.21.1",
    "npm": "9.9.4"
  },
  "packageManager": "pnpm@10.30.3"
}
