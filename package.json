{
  "name": "my-vue-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:android": "npx cap run android -l --port 5173",
    "dev:ios": "npx cap run ios -l --port 5173",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "cap:add:ios": "npx cap add ios && cd ios/App && pod install && cd -",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync && cd ios/App && pod install && cd -",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:copy": "npx cap copy",
    "stylelint": "stylelint src/**/*.{css,scss}",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:quiet": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --quiet",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest",
    "test:e2e": "echo acceptance test",
    "build:sync": "npm run build && npm run cap:sync"
  },
  "dependencies": {
    "@capacitor/android": "7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "7.4.4",
    "@capacitor/status-bar": "7.0.3",
    "@tailwindcss/vite": "4.1.17",
    "@vueuse/core": "14.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-vue-next": "0.554.0",
    "pinia": "3.0.4",
    "reka-ui": "2.6.0",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.17",
    "tailwindcss-animate": "1.0.7",
    "vue": "^3.5.24",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "9.34.0",
    "@iconify/vue": "5.0.0",
    "@rushstack/eslint-patch": "1.12.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "@typescript-eslint/parser": "8.41.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "9.34.0",
    "eslint-config-love": "122.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-cypress": "5.1.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-vue": "10.4.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier-plugin-organize-imports": "4.2.0",
    "prettier-plugin-sort-json": "4.1.1",
    "stylelint": "16.23.1",
    "stylelint-config-standard-scss": "15.0.1",
    "stylelint-prettier": "5.0.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "4.0.12",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "^3.1.3"
  },
  "volta": {
    "node": "v22.21.1",
    "npm": "9.9.4"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
