{
  "name": "triada",
  "description": "TRIADA - Fintech APP which follows the '50/30/20' rule",
  "author": "tonocp - website: https://tcarrascosa.dev",
  "url": "https://github.com/tonocp/triada",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run src --coverage",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --cache",
    "lint:check": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --cache",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check src/",
    "build:check": "pnpm format && pnpm test:unit:coverage && pnpm type-check && pnpm lint:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@primeuix/themes": "1.2.5",
    "@vueuse/core": "14.2.1",
    "pinia": "3.0.4",
    "primeicons": "7.0.0",
    "primevue": "4.5.4",
    "vue": "3.5.29",
    "vue-i18n": "11.2.8",
    "vue-router": "4.6.4",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-conventional": "20.4.2",
    "@eslint/js": "9.34.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@rushstack/eslint-patch": "1.16.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.11.0",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitejs/plugin-vue": "6.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.8.1",
    "cypress": "15.11.0",
    "eslint": "9.34.0",
    "eslint-config-love": "122.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-vue": "10.8.0",
    "fake-indexeddb": "6.2.5",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "start-server-and-test": "2.1.5",
    "terser": "5.46.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.2.5",
    "workbox-build": "7.4.1"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript@<7.0.5": "7.1.1"
    }
  },
  "volta": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@10.30.3"
}
